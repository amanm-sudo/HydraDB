# blast-radius environment variables
# Copy to .env and fill in values before running

# HydraDB connection (set by start-hydradb.sh automatically)
HYDRADB_BOLT_URI=neo4j://127.0.0.1:7687
HYDRADB_TOKEN=local-development-token-32-bytes

# API server port
PORT=3001

# Frontend API base URL (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
